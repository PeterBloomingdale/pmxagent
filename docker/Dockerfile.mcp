# ---------- Dockerfile.mcp (Python MCP Server) ----------
# Multi-stage build for smaller final image

# ============== Build stage ==============
# Pinned by tag AND digest for reproducible builds, matching Dockerfile.rapi:
# an unpinned tag lets the interpreter and its system libraries change under
# the pinned Python dependencies on any rebuild.
# This is the linux/amd64 manifest digest, resolved 2026-09-10 - builds must
# target linux/amd64, which docker-compose.yml already sets on both services.
FROM python:3.11-slim@sha256:d1053354624536b044162aaab1e418bd000ea35184fb1ae098ab3166b1072e72 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements and install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# ============== Runtime stage ==============
# Pinned by tag AND digest for reproducible builds, matching Dockerfile.rapi:
# an unpinned tag lets the interpreter and its system libraries change under
# the pinned Python dependencies on any rebuild.
# This is the linux/amd64 manifest digest, resolved 2026-09-10 - builds must
# target linux/amd64, which docker-compose.yml already sets on both services.
FROM python:3.11-slim@sha256:d1053354624536b044162aaab1e418bd000ea35184fb1ae098ab3166b1072e72

# Image metadata
LABEL maintainer="PMxAgent Team"
LABEL description="Python MCP Server for exposing R API via Model Context Protocol"

# OCI standard labels. image.source is what links the published GHCR package
# back to this repository, so the package inherits repo permissions and shows
# a Source link. The remaining OCI labels are set at the end of the file.
LABEL org.opencontainers.image.source="https://github.com/PeterBloomingdale/pmxagent"
LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
LABEL org.opencontainers.image.vendor="Generate Biomedicines"
LABEL org.opencontainers.image.title="pmxagent-mcp"
LABEL org.opencontainers.image.description="Python MCP Server for exposing R API via Model Context Protocol"

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user
RUN useradd -m -u 1001 -s /bin/bash pmxuser

# Set working directory
WORKDIR /app

# Copy only necessary application files
COPY --chown=pmxuser:pmxuser server.py /app/server.py

# Switch to non-root user
USER pmxuser

# Health check: the 2026-07-28 protocol is stateless, so server/discover is a
# complete request on its own - no handshake, no session to establish. That makes
# a single POST a valid liveness probe, which was not possible under the old
# session-based protocol.
#
# The probe is unauthenticated, so it cannot assert a 200 - it gets 401. It asserts
# the status is a real response below 500: that distinguishes "alive and handling
# requests" (200/400/401) from "alive but failing everything" (500/502/503). A bare
# `curl -s` exits 0 on a 500 and would call a broken server healthy; `curl -sf` exits
# non-zero on the 401 and would call a healthy server broken. The lower bound matters
# too - curl prints "000" when it cannot connect at all, and "000 -lt 500" is true, so
# testing only the upper bound would report a dead server as healthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD code="$(curl -s -o /dev/null -w '%{http_code}' \
        -X POST http://localhost:8000/mcp \
        -H "Content-Type: application/json" \
        -H "Accept: application/json, text/event-stream" \
        -H "MCP-Protocol-Version: 2026-07-28" \
        -H "Mcp-Method: server/discover" \
        -H "Mcp-Name: server/discover" \
        -d '{"jsonrpc":"2.0","id":1,"method":"server/discover","params":{"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}')" \
        && [ "$code" -ge 100 ] && [ "$code" -lt 500 ] || exit 1

# Environment configuration
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Build-time provenance, supplied by CI. Kept at the end of the file on purpose:
# a LABEL that consumes an ARG changes on every build, and anything below it
# would rebuild each time. Defaults keep a bare `docker build` sensible.
ARG VERSION=1.0.0
ARG VCS_REF=unknown
ARG BUILD_DATE=
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"

# Expose port
EXPOSE 8000

# Startup command
CMD ["python", "server.py"]