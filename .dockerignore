# .dockerignore - Exclude files from Docker build context

# Version control
.git/
.gitignore

# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
venv/
.venv/

# R artifacts
.Rproj.user/
.Rhistory
.RData

# IDE
.vscode/
.idea/
*.swp
*~

# Documentation (not needed in container)
*.md
examples/

# Test files (not needed in production)
tests/
pytest.ini
requirements-dev.txt

# CI/CD
.github/

# Secrets
.env
.env.*
*.key
*.pem
credentials.*

# Logs and generated files
*.log

# Runtime-populated directories - bind-mounted into the rapi container at
# runtime, never copied into an image. .gitignore treats figures/ and data/
# identically; .dockerignore now does too.
figures/
data/

# Manuscript sources - not part of any image, and .gitignore does not govern
# the build context.
manuscript/

# OS files
.DS_Store
Thumbs.db

# Claude Code
.claude/
